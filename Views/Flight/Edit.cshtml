@model Models.Flight

@{
    ViewData["Title"] = $"{ViewBag.Action} Flight";
}

<div class="row justify-content-center">
    <div class="col-12 col-lg-8">
        <div class="card shadow-sm border-0">
            <div class="card-body p-4 p-md-5">
                <h2 class="h4 mb-4">@ViewBag.Action Flight</h2>

                <form asp-action="Edit" method="post" novalidate>
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <div class="row g-3">
                        <div class="col-12">
                            <label asp-for="FlightNumber" class="form-label"></label>
                            @if (Model.FlightId == 0)
                            {
                                <input asp-for="FlightNumber" class="form-control" />
                            }
                            else
                            {
                                <input asp-for="FlightNumber" class="form-control" readonly />
                            }
                            <span asp-validation-for="FlightNumber" class="text-danger small"></span>
                        </div>

                        <div class="col-12 col-md-6">
                            <label asp-for="FromCityId" class="form-label"></label>
                            <select asp-for="FromCityId" asp-items="ViewBag.Cities" class="form-select">
                                <option value="">Select a city</option>
                            </select>
                            <span asp-validation-for="FromCityId" class="text-danger small"></span>
                        </div>

                        <div class="col-12 col-md-6">
                            <label asp-for="ToCityId" class="form-label"></label>
                            <select asp-for="ToCityId" asp-items="ViewBag.Cities" class="form-select">
                                <option value="">Select a city</option>
                            </select>
                            <span asp-validation-for="ToCityId" class="text-danger small"></span>
                        </div>

                        <div class="col-12 col-md-6">
                            <label asp-for="Date" class="form-label"></label>
                            <input asp-for="Date" class="form-control" type="date" />
                            <span asp-validation-for="Date" class="text-danger small"></span>
                        </div>

                        <div class="col-12 col-md-6">
                            <label asp-for="Price" class="form-label"></label>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <input asp-for="Price" class="form-control" type="number" min="0.01" step="0.01" />
                            </div>
                            <span asp-validation-for="Price" class="text-danger small"></span>
                        </div>
                    </div>

                    <input type="hidden" asp-for="FlightId" />

                    <div class="d-flex flex-wrap gap-2 mt-4">
                        <button type="submit" class="btn btn-primary">Save</button>
                        <a asp-controller="Flight" asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

