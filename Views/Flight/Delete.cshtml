@model Models.Flight

@{
    ViewData["Title"] = "Delete Flight";
}

<div class="row justify-content-center">
    <div class="col-12 col-lg-7">
        <div class="card border-0 shadow-sm">
            <div class="card-body p-4">
                <h2 class="h4 text-danger mb-3">Delete Flight</h2>
                <p class="mb-4">Are you sure you want to delete this flight?</p>

                <dl class="row mb-4">
                    <dt class="col-sm-4">Flight Number</dt>
                    <dd class="col-sm-8">@Model.FlightNumber</dd>

                    <dt class="col-sm-4">Route</dt>
                    <dd class="col-sm-8">@Model.FromCity?.Name → @Model.ToCity?.Name</dd>

                    <dt class="col-sm-4">Date</dt>
                    <dd class="col-sm-8">@Model.Date?.ToString("dd MMM yyyy")</dd>

                    <dt class="col-sm-4">Price</dt>
                    <dd class="col-sm-8">@Model.Price?.ToString("C")</dd>
                </dl>

                <form asp-action="Delete" method="post">
                    <input type="hidden" name="id" value="@Model.FlightId" />
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-danger">Delete</button>
                        <a asp-controller="Flight" asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
